# --------------------------------------------------------------------------- #
# SportsTech Sweden - environment variables
#
# Copy this file to ".env.local" and fill in the real values.
#   cp .env.local.example .env.local
#
# NOTE: .env.local is git-ignored. Never commit real keys.
# --------------------------------------------------------------------------- #

# --- Supabase (used by BOTH the Next.js app and the Python scripts) --------- #
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-anon-key

# --- Python scripts only (import_data.py / enrich_data.py) ------------------ #
# These are read server-side / from the CLI and must NOT have NEXT_PUBLIC_.

# Same URL as above; the Python scripts also fall back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key - bypasses row-level security so imports/updates work.
# KEEP THIS SECRET. Never expose it to the browser or commit it.
SUPABASE_KEY=sb_secret_your-service-role-key

# Anthropic Claude API key - used by enrich_data.py for web-search enrichment.
ANTHROPIC_API_KEY=sk-ant-your-key

# Admin approval page (/admin) - password to approve/reject startup submissions.
ADMIN_TOKEN=choose-your-own-admin-password

# Optional: override the Excel file location for import_data.py
# EXCEL_PATH=C:\path\to\SportsTech_Sweden_-_Mapping_of_the_industry.xlsx
