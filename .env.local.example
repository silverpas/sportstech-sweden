# --- Supabase (used by BOTH the Next.js app and the Python scripts) --------- #
NEXT_PUBLIC_SUPABASE_URL=https://dhavxruespmjjdqrydrg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pEwNDyJx-tC79xHAZZvlZA_y4Ufr5dO

# --- Python scripts only (import_data.py / enrich_data.py) ------------------ #
# These are read server-side / from the CLI and must NOT have NEXT_PUBLIC_.

# Same URL as above; the Python scripts also fall back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://dhavxruespmjjdqrydrg.supabase.co

# service_role key - bypasses row-level security so imports/updates work.
# KEEP THIS SECRET. Never expose it to the browser or commit it.
SUPABASE_KEY=sb_secret_Q0bjpK18SkdO9V3qkotaSw_DH_QoDOp

# Anthropic Claude API key - used by enrich_data.py for web-search enrichment.
ANTHROPIC_API_KEY=sk-ant-your-key

